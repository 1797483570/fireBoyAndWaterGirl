root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

# 批处理必须是 GBK + CRLF，编辑器不要自动转 UTF-8
[*.bat]
end_of_line = crlf
charset = latin1
insert_final_newline = true

# 从原站镜像来的文件一律不改动
[games/**]
insert_final_newline = false
trim_trailing_whitespace = false
end_of_line = unset
charset = unset
